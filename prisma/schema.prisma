generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
}

enum ProjectType {
  SITE_WEB
  MOBILE_APP
  AD_VIDEO
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  CHANGES_REQUESTED
  APPROVED
  PAYMENT_PENDING
  READY_FOR_DELIVERY
  DELIVERED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum VersionStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  CHANGES_REQUESTED
  FINAL
}

enum DeliverableType {
  VIDEO
  WEBSITE
  MOBILE_APP
  DOCUMENT
  ARCHIVE
  OTHER
}

enum ModificationRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  role         UserRole @default(CLIENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects     Project[] @relation("ClientProjects")
  requests     ChangeRequest[]
  validations  ProjectVersion[] @relation("VersionValidatedBy")
  modificationRequests ModificationRequest[]
}

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String?
  type          ProjectType
  status        ProjectStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)
  previewUrl    String?
  finalUrl      String?
  deliveredAt   DateTime?
  clientId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client        User            @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  versions      ProjectVersion[]
  changeRequests ChangeRequest[]

  @@index([clientId])
  @@index([status])
}

model Deliverable {
  id          String          @id @default(cuid())
  name        String
  type        DeliverableType
  description String?
  fileUrl     String?
  fileName    String
  mimeType    String?
  fileSize    Int?
  versionId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  version     ProjectVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

model ProjectVersion {
  id          String        @id @default(cuid())
  versionNumber Int
  name        String
  description String?
  previewUrl  String?
  status      VersionStatus @default(DRAFT)
  projectId   String
  validatedById String?
  validatedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  validatedBy User?         @relation("VersionValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  deliverables Deliverable[]
  modificationRequests ModificationRequest[]

  @@unique([projectId, versionNumber])
  @@index([projectId])
}

model ModificationRequest {
  id            String                    @id @default(cuid())
  versionId     String
  clientId      String
  title         String
  description   String
  status        ModificationRequestStatus @default(PENDING)
  adminResponse String?
  resolvedAt    DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  version       ProjectVersion            @relation(fields: [versionId], references: [id], onDelete: Cascade)
  client        User                      @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@index([clientId])
  @@index([status])
}

model ChangeRequest {
  id          String   @id @default(cuid())
  message     String
  response    String?
  respondedAt DateTime?
  projectId   String
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId])
}
