generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
}

enum ProjectType {
  WEBSITE
  MOBILE_APP
  AD_VIDEO
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  CHANGES_REQUESTED
  APPROVED
  PAYMENT_PENDING
  READY_FOR_DELIVERY
  DELIVERED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum VersionStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  role         UserRole @default(CLIENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects     Project[] @relation("ClientProjects")
  requests     ChangeRequest[]
  validations  ProjectVersion[] @relation("VersionValidatedBy")
}

model Project {
  id            String        @id @default(cuid())
  title         String
  description   String?
  type          ProjectType
  status        ProjectStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)
  previewUrl    String?
  finalUrl      String?
  deliveredAt   DateTime?
  clientId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client        User            @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  deliverables  Deliverable[]
  versions      ProjectVersion[]
  changeRequests ChangeRequest[]

  @@index([clientId])
  @@index([status])
}

model Deliverable {
  id          String   @id @default(cuid())
  name        String
  fileUrl     String
  isFinal     Boolean  @default(false)
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectVersion {
  id          String        @id @default(cuid())
  label       String
  notes       String?
  previewUrl  String?
  status      VersionStatus @default(DRAFT)
  projectId   String
  validatedById String?
  validatedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  validatedBy User?         @relation("VersionValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model ChangeRequest {
  id          String   @id @default(cuid())
  message     String
  response    String?
  respondedAt DateTime?
  projectId   String
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId])
}
