# PostgreSQL connection for the DigIT portal. Never commit the real .env file.
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/digit_portal?schema=public"

# Authentication secret. Generate a long random value before deploying.
NEXTAUTH_SECRET="replace_with_a_long_random_secret"
NEXTAUTH_URL="http://localhost:3000"

# First administrator. Use a normalized DRC/international phone number.
ADMIN_PHONE="+243812345678"
ADMIN_EMAIL="admin@digitagency.com"
ADMIN_PASSWORD="replace_with_a_strong_password"
ADMIN_NAME="DigIT Agency Administrator"

# Private previews must live outside /public. Use an absolute path in production.
PRIVATE_STORAGE_ROOT="./private-storage"
MAX_PREVIEW_UPLOAD_MB="200"
MAX_PAYMENT_PROOF_MB="10"

PAYMENT_MPESA_ENABLED="false"
PAYMENT_MPESA_NUMBER=""
PAYMENT_MPESA_NAME=""
PAYMENT_AIRTEL_ENABLED="false"
PAYMENT_AIRTEL_NUMBER=""
PAYMENT_AIRTEL_NAME=""
PAYMENT_ORANGE_ENABLED="false"
PAYMENT_ORANGE_NUMBER=""
PAYMENT_ORANGE_NAME=""
PAYMENT_BANK_ENABLED="false"
PAYMENT_BANK_NUMBER=""
PAYMENT_BANK_NAME=""
MAX_FINAL_UPLOAD_MB="100"
